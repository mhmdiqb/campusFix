generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TECHNICIAN
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports       Report[]
  assignments   Assignment[]
  reportUpdates ReportUpdate[]
  auditLogs     AuditLog[]
}

model FacilityCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facilities Facility[]
}

model Facility {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  location    String
  qrCode      String   @unique
  status      String   @default("GOOD")
  categoryId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category FacilityCategory @relation(fields: [categoryId], references: [id])
  reports  Report[]
}

enum ReportStatus {
  REPORTED
  VERIFIED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CONFIRMED
  REJECTED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Report {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  priority    ReportPriority @default(MEDIUM)
  status      ReportStatus   @default(REPORTED)

  userId      Int
  user        User         @relation(fields: [userId], references: [id])

  facilityId  Int?
  facility    Facility?    @relation(fields: [facilityId], references: [id])

  images      ReportImage[]
  assignment  Assignment?
  updates     ReportUpdate[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ReportImage {
  id        Int      @id @default(autoincrement())
  reportId  Int
  imageUrl  String
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Assignment {
  id           Int       @id @default(autoincrement())
  reportId     Int       @unique
  technicianId Int
  assignedAt   DateTime  @default(now())
  completedAt  DateTime?

  report     Report @relation(fields: [reportId], references: [id])
  technician User   @relation(fields: [technicianId], references: [id])
}

enum ReportUpdateType {
  STATUS_CHANGE
  NOTE
}

model ReportUpdate {
  id        Int              @id @default(autoincrement())
  reportId  Int
  userId    Int
  type      ReportUpdateType
  status    ReportStatus?
  note      String?
  createdAt DateTime         @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  entity    String
  entityId  Int
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
